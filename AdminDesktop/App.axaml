<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="AdminDesktop.App"
             RequestedThemeVariant="Default">
             <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="/Styles/ButtonStyle.axaml"/>
        <StyleInclude Source="/Styles/TextStyle.axaml"/>
        <StyleInclude Source="/Styles/TextBoxStyle.axaml"/>
        <StyleInclude Source="/Styles/MenuButton.axaml"/>
        <StyleInclude Source="/Styles/ToggleButtonStyle.axaml"/>
    </Application.Styles>
</Application>