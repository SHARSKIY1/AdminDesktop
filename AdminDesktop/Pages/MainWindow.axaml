<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1920" d:DesignHeight="1080"
        x:Class="AdminDesktop.MainWindow"
        Title="AdminDesktop">
    <Grid Background="#242C38">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="198"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="80"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Border Grid.ColumnSpan="2" BorderBrush="#4B316C" BorderThickness="0,0,0,2">
            <StackPanel Grid.ColumnSpan="2" Grid.Row="0" Background="#5B627B" Orientation="Horizontal">
                <Ellipse 
                    Height="60" 
                    Width="60" 
                    HorizontalAlignment="Left" 
                    Margin="30,0,0,0" 
                    VerticalAlignment="Center">
                    <Ellipse.Fill>
                        <ImageBrush Source="C:\Users\Алексей\Desktop\MySite\front\mysite\app\User.png" Stretch="UniformToFill"/>
                    </Ellipse.Fill>
                </Ellipse>
                <TextBlock Text="Admin" 
                           Margin="10,0,0,0" 
                           FontSize="20" 
                           Foreground="White" 
                           FontFamily="fonts:Inter#Inter"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </Border>
        <Border Grid.Row="1" BorderBrush="#4B316C" BorderThickness="0,0,2,0">
            <StackPanel Background="#5B627B" Grid.Row="1">
                <Button Classes="Selection" Content="Users" Click="Show_Users"/>
                <Button Classes="Selection" Content="Catalog"/>
                <Button Classes="Selection" Content="Statistic"/>
                <Button Classes="Selection" Content="Online" Click="Show_Online"/>
            </StackPanel>
        </Border>
        <ContentControl Grid.Column="1" Grid.Row="1" Name="ContentArea" Margin="15"/>
    </Grid>
</Window>

