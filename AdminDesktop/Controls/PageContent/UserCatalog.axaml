
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:general="using:AdminDesktop.Controls.General"
             xmlns:entities="using:Entities"
             xmlns:pageContent="using:AdminDesktop.Controls.PageContent"
             mc:Ignorable="d"
             d:DesignWidth="800"
             d:DesignHeight="450"
             x:Class="AdminDesktop.Controls.PageContent.UserCatalog"
             x:DataType="pageContent:UserCatalog">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="auto"/>
        </Grid.ColumnDefinitions>
        
        <ScrollViewer>
            <StackPanel Margin="0 0 10 0" Spacing="10">
                <general:SearchBar VerticalAlignment="Top" Height="36" />
                <StackPanel Spacing="10" Background="#5B627B">
                     <ItemsControl ItemsSource="{Binding Users}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="entities:User">
                                <general:UserCard UserSelected="UserCard_UserSelected"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <ScrollViewer Grid.Column="1">
            <Grid Background="#5B627B">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Border BorderBrush="#4B316C" 
                        BorderThickness="2">
                    <StackPanel>
                        <Border BorderBrush="#4B316C" BorderThickness="0,0,0,2" Height="52">
                            <TextBlock Text="Edit" Classes="TextStyle" HorizontalAlignment="Center" TextAlignment="Center" VerticalAlignment="Center" FontSize="24"/>
                        </Border>

                        <TextBlock Text="Nickname" Classes="TextStyle" Margin="10" FontSize="24"/>
                        <TextBox Classes="TextBoxStyle" x:Name="NickNameTextBox"/>
                        <TextBlock Text="Icon" Classes="TextStyle" Margin="10" FontSize="24"/>
                        <TextBox Classes="TextBoxStyle" x:Name="IconPathTextBox"/>
                        <Button Classes="MenuButtonStyle" Background="#7F3FCD" Content="OpenFolder"/>
                        <Image Source="/Images/user1.png" Height="270" Width="270" Margin="10" x:Name="UserIconImage"/>

                        <Button Classes="MenuButtonStyle" Background="#D6AB00" Content="Edit" HorizontalAlignment="Center" Margin="0,0,0,10" Click="Edit"/>
                        <Button Classes="MenuButtonStyle" Background="#2A2A2A" Content="Reset" HorizontalAlignment="Center" Margin="0,0,0,10" Click="Reset"/>
                    </StackPanel>
                </Border>

                <Border BorderBrush="#4B316C" 
                        BorderThickness="2"
                        Grid.Column="1">
                    <StackPanel>
                        <Border BorderBrush="#4B316C" BorderThickness="0,0,0,2" Height="52">
                            <TextBlock Text="Delete" Classes="TextStyle" HorizontalAlignment="Center" TextAlignment="Center" VerticalAlignment="Center" FontSize="24"/>
                        </Border>

                        <TextBlock Text="Cause" Classes="TextStyle" Margin="10,10,0,0" FontSize="24"/>
                        <Border BorderBrush="#4B316C" BorderThickness="2" Margin="10" Background="#242C38" CornerRadius="10">
                            <StackPanel>
                                <RadioButton Content="Cheating"
                                             Foreground="White"
                                             GroupName="Cause" x:Name="CheatingRadioButton"/>
                                <RadioButton Content="Unacceptable behavior"
                                             Foreground="White"
                                             GroupName="Cause" x:Name="BehaviorRadioButton"/>
                                <RadioButton Content="Other"
                                             Foreground="White"
                                             GroupName="Cause" x:Name="OtherRadioButton"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="CauseDescription" 
                                   Classes="TextStyle" 
                                   FontSize="24" 
                                   Margin="10"/>
                        <TextBox Classes="TextBoxStyle" 
                                 AcceptsReturn="True" 
                                 TextWrapping="Wrap" 
                                 Margin="10"
                                 x:Name="CauseDescriptionTextBox"/>
                        <Button Classes="MenuButtonStyle" Background="#8B0000" Content="Delete" HorizontalAlignment="Center" Margin="0,0,0,10" Click="Delete"/>
                        <Button Classes="MenuButtonStyle" Background="#2A2A2A" Content="Reset" HorizontalAlignment="Center" Margin="0,0,0,10" Click="Reset"/>
                    </StackPanel>
                </Border>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
