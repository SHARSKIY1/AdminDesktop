<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:general="using:AdminDesktop.Controls.General"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1700" d:DesignHeight="952"
             x:Class="AdminDesktop.Controls.PageContent.UserCatalog"
             >
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1100"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <ScrollViewer>
            <StackPanel Margin="16" Spacing="10">
                <general:SearchBar VerticalAlignment="Top" Height="36" />
                <StackPanel Spacing="10" Background="#5B627B">
                    
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Column="1">
            
        </StackPanel>
    </Grid>
</UserControl>
