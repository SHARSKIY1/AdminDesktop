<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="1200"
             d:DesignHeight="760"
             x:Class="AdminDesktop.Controls.PageContent.StatisticsContent"
             Background="#242C38">
    <Grid Margin="8" RowDefinitions="*,*" ColumnDefinitions="*,1.25*" ColumnSpacing="22" RowSpacing="16">
        <Grid Grid.Row="0" Grid.Column="0" RowDefinitions="Auto,*">
            <TextBlock Text="PaymentMethod" Classes="TextStyle" HorizontalAlignment="Center" Margin="0,0,0,6" />
            <Canvas x:Name="PaymentCanvas" Grid.Row="1" ClipToBounds="True" />
        </Grid>

        <Grid Grid.Row="0" Grid.Column="1" RowDefinitions="Auto,*">
            <TextBlock Text="UserStatistic" Classes="TextStyle" HorizontalAlignment="Center" Margin="0,0,0,6" />
            <Canvas x:Name="UsersCanvas" Grid.Row="1" ClipToBounds="True" />
        </Grid>

        <Grid Grid.Row="1" Grid.Column="0" RowDefinitions="Auto,*">
            <TextBlock Text="GameTags" Classes="TextStyle" HorizontalAlignment="Center" Margin="0,0,0,6" />
            <Canvas x:Name="TagsCanvas" Grid.Row="1" ClipToBounds="True" />
        </Grid>

        <Grid Grid.Row="1" Grid.Column="1" RowDefinitions="Auto,*">
            <TextBlock Text="Profit" Classes="TextStyle" HorizontalAlignment="Center" Margin="0,0,0,6" />
            <Canvas x:Name="ProfitCanvas" Grid.Row="1" ClipToBounds="True" />
        </Grid>
    </Grid>
</UserControl>
