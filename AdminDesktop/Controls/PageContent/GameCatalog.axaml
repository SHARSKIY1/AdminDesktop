<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:general="using:AdminDesktop.Controls.General"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="AdminDesktop.Controls.PageContent.GameCatalog"
             xmlns:entities="using:Entities"
             xmlns:pageContent="using:AdminDesktop.Controls.PageContent"
             x:DataType="pageContent:GameCatalog">

    <Grid Background="#242C38">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto" MinWidth="580"/>
        </Grid.ColumnDefinitions>
        <ScrollViewer>
            <StackPanel Margin="16" Spacing="10">
                <general:SearchBar VerticalAlignment="Top" Height="36" />
                <StackPanel Spacing="10" Background="#5B627B">
                    <ItemsControl ItemsSource="{Binding Games}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="entities:Game">
                                <general:GameCard/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
        <ScrollViewer Grid.Column="1">
            <general:Add_Edit_ControlBar Grid.Column="1"/>
        </ScrollViewer>
    </Grid>
</UserControl>