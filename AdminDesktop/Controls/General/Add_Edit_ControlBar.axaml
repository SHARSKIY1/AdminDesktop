<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="580" d:DesignHeight="952"
             x:Class="AdminDesktop.Controls.General.Add_Edit_ControlBar">
    <Grid Background="#5B627B">
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Border BorderBrush="#4B316C" BorderThickness="2">
            <StackPanel>
                <Border BorderBrush="#4B316C" BorderThickness="0,0,0,2" Height="52">
                    <TextBlock Text="Add/Edit" Classes="TextStyle" HorizontalAlignment="Center" TextAlignment="Center" VerticalAlignment="Center" FontSize="24"/>
                </Border>
                <TextBlock Text="Name" Classes="TextStyle" Margin="10" FontSize="24"/>
                <TextBox Classes="TextBoxStyle" x:Name="NameTextBox"/>
                <TextBlock Text="Tags" Classes="TextStyle" Margin="10" FontSize="24"/>
                <TextBox Classes="TextBoxStyle" x:Name="TagsTextBox"/>
                <TextBlock Text="Price" Classes="TextStyle" Margin="10" FontSize="24"/>
                <TextBox Classes="TextBoxStyle" x:Name="PriceTextBox"/>
                <TextBlock Text="ImageIcon" Classes="TextStyle" Margin="10" FontSize="24"/>
                <TextBox Classes="TextBoxStyle" x:Name="ImageIconTextBox"/>
                <Button Classes="MenuButtonStyle" Background="#7F3FCD" Content="OpenFolder" Click="OpenFolder"/>
                <Image Source="avares://AdminDesktop/Images/GameIcon.png" Height="270" Width="270" Margin="0,5,0,0" x:Name="GameIconImage"/>
                <TextBlock Text="APK-File" Classes="TextStyle" FontSize="24" Margin="10"/>
                <TextBox Classes="TextBoxStyle" x:Name="ApkFileTextBox"/>
                <Button Classes="MenuButtonStyle" Background="#D6AB00" Content="Add" HorizontalAlignment="Center" Margin="0,0,0,10" Click="AddGame"/>
                <Button Classes="MenuButtonStyle" Background="#7F3FCD" Content="Edit" HorizontalAlignment="Center" Margin="0,0,0,10" Click="EditGame"/>
                <Button Classes="MenuButtonStyle" Background="#2A2A2A" Content="Reset" HorizontalAlignment="Center" Margin="0,0,0,10" Click="ResetGame"/>
            </StackPanel>
        </Border>
        <Border BorderBrush="#4B316C" BorderThickness="2" Grid.Column="1">
            <StackPanel>
                <Border BorderBrush="#4B316C" BorderThickness="0,0,0,2" Height="52">
                    <TextBlock Text="Control" Classes="TextStyle" HorizontalAlignment="Center" TextAlignment="Center" VerticalAlignment="Center" FontSize="24"/>
                </Border>
                <TextBlock Text="Cause" Classes="TextStyle" Margin="10,10,0,0" FontSize="24"/>
                <Border BorderBrush="#4B316C" BorderThickness="2" Margin="10" Background="#242C38" CornerRadius="10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="25"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>
                        <ToggleButton Classes="ToggleButtonStyle" Margin="10" x:Name="Technical"/>
                        <TextBlock Text="Technical" Classes="TextStyle" Grid.Column="1" FontSize="20"/>
                        <ToggleButton Classes="ToggleButtonStyle" Margin="10" Grid.Row="1" x:Name="Fraud"/>
                        <TextBlock Text="Fraud" Classes="TextStyle" Grid.Row="1" Grid.Column="1" FontSize="20"/>
                        <ToggleButton Classes="ToggleButtonStyle" Margin="10" Grid.Row="2" x:Name="SecurityScam"/>
                        <TextBlock Text="SecurityScam" Classes="TextStyle" Grid.Row="2" Grid.Column="1" FontSize="20"/>
                        <ToggleButton Classes="ToggleButtonStyle" Margin="10" Grid.Row="3" x:Name="Unreabiality"/>
                        <TextBlock Text="Unreabiality" Classes="TextStyle" Grid.Row="3" Grid.Column="1" FontSize="20"/>
                        <ToggleButton Classes="ToggleButtonStyle" Margin="10" Grid.Row="4" x:Name="Vulnerability"/>
                        <TextBlock Text="Vulnerability" Classes="TextStyle" Grid.Row="4" Grid.Column="1" FontSize="20"/>
                        <ToggleButton Classes="ToggleButtonStyle" Margin="10" Grid.Row="5" x:Name="Other"/>
                        <TextBlock Text="Other" Classes="TextStyle" Grid.Row="5" Grid.Column="1" FontSize="20"/>
                    </Grid>
                </Border>
                <TextBlock Text="CauseDescription" Classes="TextStyle" FontSize="24" Margin="10"/>
                <TextBox Classes="TextBoxStyle" AcceptsReturn="True" TextWrapping="Wrap" Height="460" x:Name="DelDescription"/>
                <Button Classes="MenuButtonStyle" Background="#8B0000" Content="Delete" HorizontalAlignment="Center" Margin="0,0,0,10" Click="DeleteGame"/>
                <Button Classes="MenuButtonStyle" Background="#2A2A2A" Content="Reset" HorizontalAlignment="Center" Margin="0,0,0,10" Click="ResetGame"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
