<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="80"
             x:Class="AdminDesktop.Controls.General.GameCard"
             Height="80"
             HorizontalAlignment="Stretch"
             xmlns:entities="using:Entities"
             x:DataType="entities:Game">

    <Grid Background="#5B627B">
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Image HorizontalAlignment="Left" Grid.RowSpan="3" x:Name="IconImage"/>
        <TextBlock Text="{Binding Name}" Classes="TextStyle" Margin="87,15,0,0" Height="29" FontSize="24"/>
        <TextBlock Text="{Binding TagsText}" Classes="TextStyle" Margin="87,60,0,0" Height="29" FontSize="24"/>
    </Grid>
</UserControl>
